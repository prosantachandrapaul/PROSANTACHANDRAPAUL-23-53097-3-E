
let name = prompt("Enter student's name:");
let age = parseInt(prompt("Enter student's age:"));
let cgpa = parseFloat(prompt("Enter student's CGPA:"));
let isStudent = (prompt("Enter student status (true/false):") === "true");
let grade = prompt("Enter student's grade:");

console.log("Student Information");

console.log("Name: " + name);
console.log("Age: " + age);
console.log("Student: " + isStudent);
console.log("CGPA: " + cgpa);
console.log("Grade: " + grade);

let courses = [
    "Web Technology",
    "OOP",
    "Database"
];


console.log("Course Names");

for (let i = 0; i < courses.length; i++) {
    console.log(courses[i]);
}


let marks = parseInt(prompt("Enter student's marks:"));
let resultGrade;
if (marks >= 80) {
    resultGrade = "A+";
}
else if (marks >= 70) {
    resultGrade = "A";
}
else if (marks >= 60) {
    resultGrade = "B";
}
else {
    resultGrade = "F";
}


console.log("Marks and Result");
console.log("Marks: " + marks);
console.log("Result Grade: " + resultGrade);



function showStudent(name, age) {
    console.log("Student Name: " + name);
    console.log("Student Age: " + age);
}

console.log("Student Function")
showStudent(name, age);


let students = [];
console.log("Enter Three Student Names");

for (let i = 0; i < 3; i++) {
    students[i] = prompt("Enter student " + (i + 1) + " name:");
}


console.log("Three Student Names");
for (let i = 0; i < students.length; i++) {
    console.log(students[i]);
}
